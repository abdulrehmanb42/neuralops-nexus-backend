# Fat profile image (#170) — source baked in, no bind mount, no --reload.
# Built from the same module as docker/dev/Dockerfile.nexus-nucleus, but this
# one ships as a versioned image on Docker Hub for self-host distribution.
# Build context is ./modules/nexus-nucleus (same as dev) — see docker-compose.yaml.
#
# Build + push (until a CI pipeline exists, run by hand):
#   docker build -t noamanfaisal/neuralops-nucleus:<version> \
#     -f docker/fat/Dockerfile.nexus-nucleus .
#   docker push noamanfaisal/neuralops-nucleus:<version>

# Stage 1: Build dependencies
FROM python:3.11-slim as builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv/nexus-env
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

COPY docker/dev/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Stage 2: Final runtime — lean, source baked in, no dev tools/sudo
FROM python:3.11-slim

RUN set -eux; \
    apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    curl; \
    adduser --disabled-password --gecos '' neuralops; \
    mkdir -p /nexus-nucleus; \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder --chown=neuralops:neuralops /opt/venv/nexus-env /opt/venv/nexus-env
COPY --chown=neuralops:neuralops . /nexus-nucleus

ENV VIRTUAL_ENV=/opt/venv/nexus-env
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV PYTHONPATH=/nexus-nucleus

WORKDIR /nexus-nucleus
USER neuralops

EXPOSE 8000

# No --reload, fixed worker count — this is the production-style entrypoint,
# not the dev hot-reload one. nucleus-celery-fat reuses this same image with
# a different `command:` in docker-compose.yaml (same pattern as
# nucleus-celery-dev reusing the nucleus-dev image).
CMD ["uvicorn", "core.asgi:application", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
