# Supabase identity project (anon key is public by design — it ships in the
# browser bundle). Copy to .env.local and fill in your project's values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, dev-only. This host's own LAN IPs are auto-allowed for `next dev`
# already; add extra origins here (comma-separated) only for hostnames that
# aren't local IPs — e.g. a Tailscale name or a custom domain. No effect on the
# production build. Example: NEXT_DEV_ALLOWED_ORIGINS=my-box.tailnet.ts.net,dev.example.com
# NEXT_DEV_ALLOWED_ORIGINS=
