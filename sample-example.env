# --- SYSTEM SETTINGS ---
PROJECT_NAME=Nexus
ENV=development

# --- DATABASE SECRETS ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=nucleus_db
# Internal URL for Nucleus to use
POSTGRES_URL=postgresql+asyncpg://admin:password@postgres:5432/nucleus_db

# --- REAL-TIME ENGINE (CENTRIFUGO) ---
CENTRIFUGO_API_KEY=nexus_temp_key_2026
CENTRIFUGO_HMAC_SECRET=nexus_temp_secret
# Internal URL for Nucleus to reach the Go engine
CENTRIFUGO_API_URL=http://realtime:8000/api

# --- AI WORKER (LITELLM) ---
# Replace these with your actual keys
OPENAI_API_KEY=sk-xxxx...
ANTHROPIC_API_KEY=sk-ant-...
MODEL_NAME=gpt-4o

# Internal URL for Nucleus to reach Nexus-AI
NEXUS_AI_URL=http://nexus-ai:8000

# --- NEXUS-MCP: First-party MCP tool server ---
# Shopping: serpapi.com — covers BestBuy, Walmart, Amazon, Target and more
# Sign up at serpapi.com (100 free searches/month, instant key, no verification)
SERPAPI_KEY=
# ERP (Odoo)
ERP_URL=http://odoo:8069
ERP_DB=odoo
ERP_USERNAME=admin
ERP_PASSWORD=admin
# SSH defaults (optional — can also be passed per-call)
SSH_DEFAULT_HOST=
SSH_DEFAULT_PORT=22
SSH_DEFAULT_USER=
SSH_DEFAULT_PASSWORD=
SSH_DEFAULT_KEY_PATH=
# Restrict which paths the AI can list/read (comma-separated prefixes)
# Leave empty to allow all paths (not recommended)
SSH_ALLOWED_PATHS=/var/log,/etc/nginx,/home
# Restrict which commands the AI can run (comma-separated prefixes)
# Leave empty to allow all commands (not recommended)
SSH_ALLOWED_COMMANDS=df,free,uptime,ls,cat,tail,head,ps,systemctl status

# --- VECTOR DATABASE ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

