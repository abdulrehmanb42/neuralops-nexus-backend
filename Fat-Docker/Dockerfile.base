# ── Stage 1: pgvector builder ────────────────────────────────────────────────
# Debian's postgresql package doesn't ship the pgvector extension, so it's
# built from source here (small C extension, this is the officially
# documented install path).
FROM python:3.12-slim AS pgvector-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql postgresql-server-dev-all build-essential git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --branch v0.7.4 https://github.com/pgvector/pgvector.git /tmp/pgvector && \
    cd /tmp/pgvector && make && make install

# Stage the compiled files at a fixed, version-independent path. pg_config
# (from postgresql-server-dev-all, only present in THIS stage) resolves the
# real install locations for whatever Postgres major version Debian
# actually installed -- nothing here hardcodes a version number, which is
# what broke the first attempt (guessed "15", actual version differed).
RUN mkdir -p /pgvector-out/lib /pgvector-out/extension && \
    cp "$(pg_config --pkglibdir)/vector.so" /pgvector-out/lib/ && \
    cp "$(pg_config --sharedir)"/extension/vector* /pgvector-out/extension/

# ── Stage 2: final base image — build once, push to Docker Hub ─────────────
FROM python:3.12-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates nginx postgresql redis-server sudo nodejs npm && \
    rm -rf /var/lib/apt/lists/*

# Filesystem MCP -- the official reference server (modelcontextprotocol/servers),
# used to give every project access to its own folder by default (see
# Fat-Docker/README or bootstrap.py for how it's pointed at
# /nexus/projects/<project-id>/ per project -- safety of this server
# depends entirely on that scoping, it has no sandboxing of its own beyond
# the allowed-directories list it's started with).
# Installed globally at build time (not left to `npx` to fetch on first
# run) so it works offline and starts instantly -- no internet access
# needed at runtime just to spawn a local tool.
RUN npm install -g @modelcontextprotocol/server-filesystem

# Drop the staged pgvector files into wherever THIS stage's postgresql
# package actually put its lib/extension directories -- detected from the
# version-numbered directory name itself (e.g. /usr/lib/postgresql/17),
# not hardcoded, and without needing pg_config/dev headers in this final
# image just to look the path up.
COPY --from=pgvector-builder /pgvector-out/ /tmp/pgvector-out/
RUN PG_VERSION=$(ls /usr/lib/postgresql/) && \
    cp /tmp/pgvector-out/lib/vector.so /usr/lib/postgresql/$PG_VERSION/lib/ && \
    cp /tmp/pgvector-out/extension/vector* /usr/share/postgresql/$PG_VERSION/extension/ && \
    rm -rf /tmp/pgvector-out

ARG UID=1000
RUN useradd -m -u $UID nexus

# Postgres data dir -- the actual data volume gets mounted over this at
# `docker run` time; this just ensures the directory/ownership exist so
# `su postgres -c "pg_ctl ..."` works without extra setup later.
RUN mkdir -p /var/lib/postgresql/data && \
    chown -R postgres:postgres /var/lib/postgresql/data

# nginx runs its master process as root (standard nginx behavior) and
# drops worker processes to `nexus` via the `user` directive in
# nginx.conf, set later in Dockerfile.nexus.
RUN mkdir -p /var/lib/nginx /var/log/nginx && \
    chown -R nexus:nexus /var/lib/nginx /var/log/nginx

# Redis -- Celery's broker/result backend only, not a system of record
# (Celery Beat's actual schedule lives in Postgres via django-celery-beat's
# DatabaseScheduler). Debian's redis-server package already creates its
# own `redis` system user and /var/lib/redis with correct ownership on
# install, unlike the from-source pgvector build above -- nothing extra
# needed here. A persistence volume at /var/lib/redis is optional, not
# required, at `docker run` time -- losing queued/in-flight tasks on a
# restart is a minor inconvenience here, not real data loss.
