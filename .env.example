# Copy this file to .env and fill in real values. .env is gitignored on
# purpose (see .gitignore) -- never commit real secrets. See #143 / #170 /
# TASKS.md / DECISIONS.md §20.
#
# COMPOSE_PROFILES=dev below is the default so a bare `docker compose up -d`
# just works for local dev. To run the fat profile instead, use
# `docker compose --profile fat up -d` (most people should use install.sh
# instead of filling in the FAT_* section by hand -- see SELF-HOST.md).
# production gets its own PROD_* block here later, once that profile exists.

COMPOSE_PROFILES=dev

# =========================================================
# Database
# =========================================================
DEV_POSTGRES_USER=neuralops
DEV_POSTGRES_PASSWORD=change-me
DEV_POSTGRES_DB=neuralops_dev
# Must match the three values above: postgresql+asyncpg://USER:PASSWORD@postgres-dev:5432/DB
DEV_POSTGRES_URL=postgresql+asyncpg://neuralops:change-me@postgres-dev:5432/neuralops_dev

# =========================================================
# Internal shared secrets -- not tied to any external service, just need to
# be long random strings shared between our own containers. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# for FIELD_ENCRYPTION_KEY specifically; any random string works for the rest.
# =========================================================
DEV_FIELD_ENCRYPTION_KEY=
DEV_INTERNAL_API_KEY=
DEV_CENTRIFUGO_API_KEY=
DEV_CENTRIFUGO_HMAC_SECRET=

# =========================================================
# Supabase (auth) -- URL + anon key are public by design (Supabase's own
# docs say these are safe to ship in a frontend bundle; access is enforced
# by RLS policies, not by keeping this key secret), so the real values are
# committed here. SERVICE_KEY bypasses RLS entirely -- that one is a real
# secret, get it from your Supabase project settings -> API and never commit it.
# =========================================================
DEV_SUPABASE_URL=https://xgfsxikypxjhqlutiepw.supabase.co
DEV_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhnZnN4aWt5cHhqaHFsdXRpZXB3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIyNDg3MDcsImV4cCI6MjA5NzgyNDcwN30.2_OUNTHuKSeDJh6S-aUW16IqvDTmew8ZcFuKvFkt3Dk
DEV_SUPABASE_SERVICE_KEY=

# =========================================================
# AI providers
# =========================================================
DEV_OPENAI_API_KEY=
DEV_ANTHROPIC_API_KEY=
# DEV_LLM_MODEL=anthropic/claude-haiku-4-5-20251001   # optional, has a default
# DEV_EMBEDDING_PROVIDER=fastembed                     # optional, has a default
# DEV_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5   # optional, has a default

# =========================================================
# Server identity -- must be the URL/port this box is actually reachable at,
# not just localhost, or login/Centrifugo will silently fail for anyone
# connecting from another machine.
# =========================================================
DEV_NEURALOPS_INSTALL_TOKEN=
DEV_NEURALOPS_SERVER_URL=http://localhost:8081
# DEV_NEURALOPS_PORTAL_URL=https://neuralops-nexus-auth.mapax.io   # optional, has a default

# =========================================================
# Host ports -- optional, shown here at their defaults. Only change if
# something else on this machine already uses one of these.
# =========================================================
# DEV_NGINX_HOST_PORT=8081
# DEV_POSTGRES_HOST_PORT=5433
# DEV_REDIS_HOST_PORT=6379
# DEV_NEXUS_AI_HOST_PORT=8000
# DEV_REACT_HOST_PORT=3003


# =============================================================================
# FAT profile (#170, self-host distribution) -- pre-built Docker Hub images,
# no source tree needed. Run with: docker compose --profile fat up -d
# Most people should use install.sh instead of filling this in by hand --
# see SELF-HOST.md and DECISIONS.md §20 for the full story.
# =============================================================================
FAT_VERSION=0.1.1

# --- Database ---
FAT_POSTGRES_USER=neuralops
FAT_POSTGRES_PASSWORD=change-me
FAT_POSTGRES_DB=neuralops_fat
# Must match the three values above: postgresql+asyncpg://USER:PASSWORD@postgres-fat:5432/DB
FAT_POSTGRES_URL=postgresql+asyncpg://neuralops:change-me@postgres-fat:5432/neuralops_fat

# --- Internal shared secrets -- any random string, e.g.
# python3 -c "import secrets; print(secrets.token_hex(32))" -- except
# FAT_FIELD_ENCRYPTION_KEY, which needs:
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())" ---
FAT_FIELD_ENCRYPTION_KEY=
FAT_INTERNAL_API_KEY=
FAT_CENTRIFUGO_API_KEY=
FAT_CENTRIFUGO_HMAC_SECRET=

# --- Supabase (auth) -- URL + anon key are public by design, same as DEV_* above ---
FAT_SUPABASE_URL=https://xgfsxikypxjhqlutiepw.supabase.co
FAT_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhnZnN4aWt5cHhqaHFsdXRpZXB3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIyNDg3MDcsImV4cCI6MjA5NzgyNDcwN30.2_OUNTHuKSeDJh6S-aUW16IqvDTmew8ZcFuKvFkt3Dk
FAT_SUPABASE_SERVICE_KEY=

# --- AI providers ---
FAT_OPENAI_API_KEY=
FAT_ANTHROPIC_API_KEY=
# FAT_LLM_MODEL=anthropic/claude-haiku-4-5-20251001   # optional, has a default
# FAT_EMBEDDING_PROVIDER=fastembed                     # optional, has a default
# FAT_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5   # optional, has a default

# --- Server identity -- install.sh sets this automatically once Tailscale
# Funnel is up. If setting by hand, this must be the URL other people will
# actually reach this server at, not localhost. ---
FAT_NEURALOPS_INSTALL_TOKEN=
FAT_NEURALOPS_SERVER_URL=http://localhost:8090
# FAT_NEURALOPS_PORTAL_URL=https://neuralops-nexus-auth.mapax.io   # optional, has a default

# --- Host ports -- optional, shown here at their defaults. Deliberately
# different from the DEV_* ports above so dev and fat can run side by side
# on the same machine without colliding. ---
# FAT_NGINX_HOST_PORT=8090
# FAT_POSTGRES_HOST_PORT=5440
# FAT_REDIS_HOST_PORT=6390
# FAT_NEXUS_AI_HOST_PORT=8010
